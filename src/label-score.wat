(module
  (memory (export "memory") 1)
  ;; Slab clipping for two independent segments, including parallel axes.
  (func $axis (param $s v128) (param $d v128) (param $min v128) (param $max v128)
    (result v128 v128 v128)
    (local $parallel v128) (local $a v128) (local $b v128)
    (local.set $parallel (f64x2.lt (f64x2.abs (local.get $d)) (f64x2.splat (f64.const 1e-9))))
    (local.set $a (f64x2.div (f64x2.sub (local.get $min) (local.get $s)) (local.get $d)))
    (local.set $b (f64x2.div (f64x2.sub (local.get $max) (local.get $s)) (local.get $d)))
    (v128.bitselect (f64x2.splat (f64.const 0)) (f64x2.min (local.get $a) (local.get $b)) (local.get $parallel))
    (v128.bitselect (f64x2.splat (f64.const 1)) (f64x2.max (local.get $a) (local.get $b)) (local.get $parallel))
    (v128.not (v128.and (local.get $parallel)
      (v128.or (f64x2.lt (local.get $s) (local.get $min)) (f64x2.gt (local.get $s) (local.get $max))))))
  (func $hits (param $x v128) (param $y v128) (param $dx v128) (param $dy v128)
    (param $left v128) (param $right v128) (param $top v128) (param $bottom v128) (result v128)
    (local $lo v128) (local $hi v128) (local $valid v128)
    (local $ylo v128) (local $yhi v128) (local $yvalid v128)
    (call $axis (local.get $x) (local.get $dx) (local.get $left) (local.get $right))
    (local.set $valid) (local.set $hi) (local.set $lo)
    (local.set $lo (f64x2.max (f64x2.splat (f64.const 0)) (local.get $lo)))
    (local.set $hi (f64x2.min (f64x2.splat (f64.const 1)) (local.get $hi)))
    (local.set $valid (v128.and (local.get $valid) (v128.not (f64x2.gt (local.get $lo) (local.get $hi)))))
    (if (i32.eqz (v128.any_true (local.get $valid))) (then (return (local.get $valid))))
    (call $axis (local.get $y) (local.get $dy) (local.get $top) (local.get $bottom))
    (local.set $yvalid) (local.set $yhi) (local.set $ylo)
    (v128.and (v128.and (local.get $valid) (local.get $yvalid))
      (v128.not (f64x2.gt (f64x2.max (local.get $lo) (local.get $ylo)) (f64x2.min (local.get $hi) (local.get $yhi))))))
  ;; Five padded f64 arrays: start x/y, delta x/y, Math.hypot length (computed in JS).
  (func (export "count") (param $n i32) (param $rx f64) (param $ry f64) (param $rw f64) (param $rh f64)
    (param $leader i32) (param $sx f64) (param $sy f64) (param $ex f64) (param $ey f64)
    (param $count i32) (param $overlap f64) (param $travel f64) (param $best f64) (result i32)
    (local $i i32) (local $bytes i32) (local $mask i32)
    (local $x v128) (local $y v128) (local $dx v128) (local $dy v128) (local $length v128)
    (local $left v128) (local $right v128) (local $top v128) (local $bottom v128)
    (local $ax v128) (local $ay v128) (local $bx v128) (local $by v128)
    (local $lx v128) (local $ly v128) (local $leX v128) (local $leY v128)
    (local $hit v128) (local $pointHit v128)
    (local.set $bytes (i32.mul (i32.add (local.get $n) (i32.and (local.get $n) (i32.const 1))) (i32.const 8)))
    (local.set $left (f64x2.splat (f64.sub (local.get $rx) (f64.const 3))))
    (local.set $right (f64x2.splat (f64.add (f64.add (local.get $rx) (local.get $rw)) (f64.const 3))))
    (local.set $top (f64x2.splat (f64.sub (local.get $ry) (f64.const 3))))
    (local.set $bottom (f64x2.splat (f64.add (f64.add (local.get $ry) (local.get $rh)) (f64.const 3))))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $bytes)))
        (local.set $mask (select (i32.const 3) (i32.const 1)
          (i32.lt_u (i32.add (local.get $i) (i32.const 8)) (i32.mul (local.get $n) (i32.const 8)))))
        (local.set $x (v128.load (local.get $i)))
        (local.set $y (v128.load (i32.add (local.get $i) (local.get $bytes))))
        (local.set $dx (v128.load (i32.add (local.get $i) (i32.mul (local.get $bytes) (i32.const 2)))))
        (local.set $dy (v128.load (i32.add (local.get $i) (i32.mul (local.get $bytes) (i32.const 3)))))
        (local.set $length (v128.load (i32.add (local.get $i) (i32.mul (local.get $bytes) (i32.const 4)))))
        (local.set $hit (call $hits (local.get $x) (local.get $y) (local.get $dx) (local.get $dy)
          (local.get $left) (local.get $right) (local.get $top) (local.get $bottom)))
        (local.set $count (i32.add (local.get $count)
          (i32.mul (i32.const 4) (i32.popcnt (i32.and (local.get $mask) (i64x2.bitmask (local.get $hit)))))))
        (if (local.get $leader) (then
          (local.set $ax (f64x2.sub (f64x2.splat (local.get $sx)) (local.get $x)))
          (local.set $ay (f64x2.sub (f64x2.splat (local.get $sy)) (local.get $y)))
          (local.set $bx (f64x2.sub (f64x2.splat (local.get $ex)) (local.get $x)))
          (local.set $by (f64x2.sub (f64x2.splat (local.get $ey)) (local.get $y)))
          (local.set $lx (f64x2.div (f64x2.add (f64x2.mul (local.get $ax) (local.get $dx)) (f64x2.mul (local.get $ay) (local.get $dy))) (local.get $length)))
          (local.set $ly (f64x2.div (f64x2.sub (f64x2.mul (local.get $ay) (local.get $dx)) (f64x2.mul (local.get $ax) (local.get $dy))) (local.get $length)))
          (local.set $leX (f64x2.div (f64x2.add (f64x2.mul (local.get $bx) (local.get $dx)) (f64x2.mul (local.get $by) (local.get $dy))) (local.get $length)))
          (local.set $leY (f64x2.div (f64x2.sub (f64x2.mul (local.get $by) (local.get $dx)) (f64x2.mul (local.get $bx) (local.get $dy))) (local.get $length)))
          (local.set $hit (call $hits (local.get $lx) (local.get $ly)
            (f64x2.sub (local.get $leX) (local.get $lx)) (f64x2.sub (local.get $leY) (local.get $ly))
            (f64x2.splat (f64.const -2)) (f64x2.add (local.get $length) (f64x2.splat (f64.const 2)))
            (f64x2.splat (f64.const -2)) (f64x2.splat (f64.const 2))))
          (if (v128.any_true (f64x2.lt (local.get $length) (f64x2.splat (f64.const 1e-9)))) (then
            (local.set $pointHit (call $hits (f64x2.splat (local.get $sx)) (f64x2.splat (local.get $sy))
            (f64x2.splat (f64.sub (local.get $ex) (local.get $sx))) (f64x2.splat (f64.sub (local.get $ey) (local.get $sy)))
            (f64x2.sub (local.get $x) (f64x2.splat (f64.const 2))) (f64x2.add (local.get $x) (f64x2.splat (f64.const 2)))
            (f64x2.sub (local.get $y) (f64x2.splat (f64.const 2))) (f64x2.add (local.get $y) (f64x2.splat (f64.const 2)))))
          (local.set $hit (v128.bitselect (local.get $pointHit) (local.get $hit)
            (f64x2.lt (local.get $length) (f64x2.splat (f64.const 1e-9)))))))
          (local.set $count (i32.add (local.get $count) (i32.popcnt (i32.and (local.get $mask) (i64x2.bitmask (local.get $hit))))))))
        ;; Check after each pair; all penalties are nonnegative, as in the JS early exit.
        (br_if $done (f64.ge
          (f64.add (f64.add (f64.mul (local.get $overlap) (f64.const 1000)) (f64.mul (f64.convert_i32_u (local.get $count)) (f64.const 200))) (local.get $travel))
          (local.get $best)))
        (local.set $i (i32.add (local.get $i) (i32.const 16)))
        (br $next)))
    (local.get $count)))
